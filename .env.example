# ==============================================================================
# Banana Quest — Environment Configuration Template
# CIS046-3: Software for Enterprise
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security & Virtual Identity (Theme 4)
# Generate a secure 64-char hex key for production: openssl rand -hex 32
JWT_SECRET=dev_banana_quest_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
COOKIE_NAME=banana_quest_session

# Google OAuth 2.0 Identity Federation (Google Identity Services)
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# External Interoperability Services (Theme 3)
BANANA_API_URL=https://marcconrad.com/uob/banana/api.php?out=json
BANANA_API_TIMEOUT_MS=8000
BANANA_API_CACHE_TTL_MS=60000

# Database Persistence
DATABASE_FILE=server/data/banana_quest.sqlite
